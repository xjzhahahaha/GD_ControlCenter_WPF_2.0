<UserControl x:Class="GD_ControlCenter_WPF.Views.Pages.FlowInjectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:helpers="clr-namespace:GD_ControlCenter_WPF.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1280">

    <UserControl.Resources>
        <!-- 转换器：用于按钮状态互斥 -->
        <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.5*" />
            <!-- 1. 左侧：序列 -->
            <ColumnDefinition Width="5*" />
            <!-- 2. 中间：图表 -->
            <ColumnDefinition Width="2.5*" />
            <!-- 3. 右侧：结果与控制 -->
        </Grid.ColumnDefinitions>

        <!-- ================= 1. 左侧：进样序列管理 ================= -->
        <materialDesign:Card Grid.Column="0" Margin="5" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="流动注射任务序列" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Opacity="0.6"/>

                <DataGrid Grid.Row="1" ItemsSource="{Binding MeasurementSequence}" 
                          SelectedItem="{Binding CurrentSample}"
                          AutoGenerateColumns="False" IsReadOnly="True" 
                          SelectionMode="Single" HeadersVisibility="Column"
                          IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="85">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="正在扫描...">
                                            <Setter Property="Foreground" Value="Orange"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="已完成">
                                            <Setter Property="Foreground" Value="Green"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="样品名称" Binding="{Binding SampleName}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>

        <!-- ================= 2. 中间：双图监控区 ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <!-- 上图：全谱图 -->
                <RowDefinition Height="*" />
                <!-- 下图：单元素时序图 -->
            </Grid.RowDefinitions>

            <!-- 2.1 实时光谱全览 -->
            <materialDesign:Card Grid.Row="0" Margin="2.5,5" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <TextBlock Text="实时全谱监控 (Full Spectrum)" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="15,10" Opacity="0.5" Style="{StaticResource MaterialDesignSubtitle2TextBlock}"/>
                    <ScottPlot:WpfPlot x:Name="SpecPlot" Margin="5,35,5,5"/>
                </Grid>
            </materialDesign:Card>

            <!-- 2.2 信号强度时序图 (针对流动注射扫描) -->
            <materialDesign:Card Grid.Row="1" Margin="2.5,5" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="15,10" Panel.ZIndex="1">
                        <TextBlock Text="监控元素：" VerticalAlignment="Center" Opacity="0.6"/>
                        <TextBlock Text="全部配置元素 (自动分配图例颜色)" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock Text="流动注射实时出峰图" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="15,10" Opacity="0.5" Style="{StaticResource MaterialDesignSubtitle2TextBlock}"/>
                    <ScottPlot:WpfPlot x:Name="TimeSeriesPlot" Margin="5,45,5,5"/>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- ================= 3. 右侧：扫描记录与核心控制 ================= -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- 当前样品信息 -->
                <RowDefinition Height="*" />
                <!-- 历史扫描结果记录 -->
                <RowDefinition Height="Auto" />
                <!-- 三个控制按钮 -->
            </Grid.RowDefinitions>

            <!-- 3.1 样品状态头部 -->
            <materialDesign:Card Margin="5" UniformCornerRadius="8" Background="{DynamicResource PrimaryHueMidBrush}" Foreground="White">
                <StackPanel Margin="15">
                    <TextBlock Text="当前测量对象" FontSize="12" Opacity="0.8"/>
                    <TextBlock Text="{Binding CurrentSample.SampleName, FallbackValue='未选择样品'}" FontSize="18" FontWeight="Bold" Margin="0,5" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentSample.SampleName}"/>
                    <TextBlock Text="模式：流动注射 (FI)" FontSize="12"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- 3.2 扫描记录表 (记录该样品产生的每一个峰) -->
            <materialDesign:Card Grid.Row="1" Margin="5" UniformCornerRadius="8">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="扫描峰值记录" FontWeight="Bold" Opacity="0.6" Style="{StaticResource MaterialDesignSubtitle2TextBlock}"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding CurrentSample.ElementConcentrations}" FontSize="12"
                              AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="元素" Binding="{Binding ElementName}" Width="*"/>
                            <DataGridTextColumn Header="平均峰高" Binding="{Binding MeasuredIntensity, StringFormat={}{0:F2}}" Width="*"/>
                            <DataGridTextColumn Header="RSD (%)" Binding="{Binding MeasuredRsd, StringFormat={}{0:F2}}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>

            <!-- 3.3 核心扫描控制器 -->
            <materialDesign:Card Grid.Row="2" Margin="5" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp3">
                <StackPanel Margin="10">
                    <!-- 按钮 1：控制单次出峰开始 -->
                    <Button Content="开始采集扫描" Height="50" Margin="0,0,0,5"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding StartScanCommand}"
                            IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"/>

                    <!-- 按钮 2：控制扫描结束并自动计算该峰高度 -->
                    <Button Content="停止扫描并存峰" Height="50" Margin="0,0,0,10"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="Orange" BorderBrush="Orange"
                            Command="{Binding StopScanCommand}"
                            IsEnabled="{Binding IsScanning}"/>

                    <Separator Style="{StaticResource MaterialDesignLightSeparator}" Margin="0,5"/>

                    <Button Content="清空本样品测量数据" Height="40" Margin="0,0,0,10"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="IndianRed" BorderBrush="IndianRed"
                            Command="{Binding ClearCurrentSampleDataCommand}"
                            ToolTip="如果误触或需要重测，点击清空当前选中样品的全部流注数据"/>

                    <Button Content="该样品测定完成" Height="45" Margin="0,0,0,10"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding FinishSampleCommand}"/>

                    <Button Content="实验结束并处理数据" Height="45"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#4caf50" BorderBrush="#4caf50"
                            Command="{Binding FinishExperimentAndNavigateCommand}"
                            ToolTip="结束全部样品的测试，并自动跳转至数据处理界面"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>