<UserControl x:Class="GD_ControlCenter_WPF.Views.Pages.DataProcessingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:helpers="clr-namespace:GD_ControlCenter_WPF.Helpers"
             Background="{DynamicResource MaterialDesignPaper}">

    <UserControl.Resources>
        <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4.5*" />
            <!-- 左列：配置与图表 -->
            <ColumnDefinition Width="5.5*" />
            <!-- 右列：分析结果中心 -->
        </Grid.ColumnDefinitions>

        <!-- ================= 左侧列 ================= -->
        <Grid Grid.Column="0" Margin="0,0,6,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 0. 元素选择(保留) -->
                <RowDefinition Height="4*"/>
                <!-- 1. 曲线预览(保留) -->
                <RowDefinition Height="3.5*"/>
                <!-- 2. 采集结果(重构) -->
            </Grid.RowDefinitions>

            <!-- 0. 顶部栏：元素选择 (保持原样) -->
            <materialDesign:Card Grid.Row="0" Margin="0,0,0,8" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel Orientation="Horizontal" Margin="15,10">
                    <!-- 标题区 -->
                    <materialDesign:PackIcon Kind="GoogleAnalytics" VerticalAlignment="Center" Width="24" Height="24" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    <TextBlock Text="数据处理中心" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,20,0"/>

                    <Separator Style="{StaticResource MaterialDesignLightSeparator}" Width="2" Height="24" Margin="0,0,20,0">
                        <Separator.LayoutTransform>
                            <RotateTransform Angle="90"/>
                        </Separator.LayoutTransform>
                    </Separator>

                    <!-- 元素选择区 -->
                    <TextBlock Text="当前分析元素:" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,10,0"/>
                    <ComboBox Width="120" ItemsSource="{Binding ActiveElements}" 
                  SelectedItem="{Binding SelectedElement}" 
                  Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                    <!-- 【新增】：导入数据按钮 -->
                    <Button Command="{Binding ImportExternalDataCommand}" 
                Style="{StaticResource MaterialDesignFlatButton}" 
                Margin="12,0,0,0"
                ToolTip="导入之前导出的实验快照 (.json)">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileImport" VerticalAlignment="Center" Width="20" Height="20"/>
                            <TextBlock Text="导入数据" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </materialDesign:Card>

            <!-- 1. 中部：校准曲线图 (保持原样) -->
            <materialDesign:Card Grid.Row="1" Margin="0,0,0,8" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <TextBlock Text="{Binding SelectedElement, StringFormat='校准曲线 ({0})'}" Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="10" Opacity="0.5" Panel.ZIndex="1"/>
                    <Border Background="Black" CornerRadius="8" Margin="8,30,8,8">
                        <ScottPlot:WpfPlot x:Name="CalibrationPlot" />
                    </Border>
                </Grid>
            </materialDesign:Card>

            <!-- 2. 左下角：按元素筛选后的结果结果  -->
            <materialDesign:Card Grid.Row="2" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <materialDesign:PackIcon Kind="FilterList" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBlock Text="{Binding SelectedElement, StringFormat='样品测定结果明细 - {0}'}" 
                       FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" Opacity="0.6"/>
                    </StackPanel>

                    <!-- 统一的 DataGrid：现在它的行是按照选中的元素来展示的 -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredResults}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="样品名称" Binding="{Binding SampleName}" Width="1.5*"/>
                            <DataGridTextColumn Header="样品类型" Binding="{Binding SampleType}" Width="*"/>

                            <!-- 这里的 Intensity 就是该选定元素的强度 -->
                            <DataGridTextColumn Header="测量强度" Binding="{Binding Intensity, StringFormat={}{0:F1}}" Width="*"/>
                            <DataGridTextColumn Header="RSD(%)" Binding="{Binding RSD, StringFormat={}{0:F2}}" Width="0.8*"/>

                            <!-- 根据拟合曲线算出的结果 -->
                            <DataGridTextColumn Header="算得浓度" Binding="{Binding CalculatedConc, StringFormat={}{0:F3}}" 
                                    Width="*" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- ================= 右侧列 ================= -->
        <Grid Grid.Column="1" Margin="6,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 分析性能指标 -->
                <RowDefinition Height="*"/>
                <!-- 标准点表格 -->
                <RowDefinition Height="Auto"/>
                <!-- 操作按钮 -->
            </Grid.RowDefinitions>

            <!-- 1. 右上角：分析性能指标 (重构布局以加入按钮) -->
            <materialDesign:Card Grid.Row="0" Margin="0,0,0,8" UniformCornerRadius="8" 
                     Background="{DynamicResource PrimaryHueLightBrush}" 
                     Foreground="{DynamicResource PrimaryHueLightForegroundBrush}">
                <Grid Margin="16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- 标题 -->
                        <RowDefinition Height="*"/>
                        <!-- 指标内容 -->
                        <RowDefinition Height="Auto"/>
                        <!-- 新增按钮行 -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="拟合模型性能分析" FontWeight="Bold" Margin="0,0,0,12"/>

                    <!-- 指标展示区 -->
                    <UniformGrid Grid.Row="1" Columns="2">
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="检出限 (LOD)" FontSize="11" Opacity="0.7"/>
                            <TextBlock Text="{Binding LodValue, StringFormat={}{0:F3} μg/L}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="相关系数 (R²)" FontSize="11" Opacity="0.7"/>
                            <TextBlock Text="{Binding RSquaredText}" FontSize="20" FontWeight="Bold" Foreground="#81C784"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="背景等效浓度 (BEC)" FontSize="11" Opacity="0.7"/>
                            <TextBlock Text="{Binding BecValue, StringFormat={}{0:F2} μg/L}" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="拟合方程" FontSize="11" Opacity="0.7"/>
                            <TextBlock Text="{Binding EquationText}" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </UniformGrid>

                    <Button Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Style="{StaticResource MaterialDesignFlatButton}"
                Foreground="{DynamicResource PrimaryHueLightForegroundBrush}"
                Command="{Binding CalculateFittingCommand}"
                Margin="0,8,-8,-4" Height="32" Padding="8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="更新拟合" Margin="4,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </materialDesign:Card>

            <!-- 2. 标准点表格 -->
            <materialDesign:Card Grid.Row="1" Margin="0,4,0,8" UniformCornerRadius="8">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="标准点校准数据 (双击启用/禁用)" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" Margin="0,0,0,8" Opacity="0.6"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding StandardPoints}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="标准品名称" Binding="{Binding Name}" Width="1.5*"/>
                            <DataGridTextColumn Header="已知浓度" Binding="{Binding Concentration}" Width="*"/>
                            <DataGridTextColumn Header="响应强度" Binding="{Binding Intensity}" Width="*"/>
                            <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnabled}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>

            <!-- 3. 底部操作按钮 -->
            <materialDesign:Card Grid.Row="2" UniformCornerRadius="8" Padding="12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="导出结果 (CSV)" Command="{Binding ExportDataCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
                    <Button Content="生成实验报告" Command="{Binding GenerateReportCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#1E88E5" BorderBrush="#1E88E5"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>