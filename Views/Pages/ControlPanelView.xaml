<UserControl x:Class="GD_ControlCenter_WPF.Views.Pages.ControlPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:components="clr-namespace:GD_ControlCenter_WPF.Views.Components"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="{Binding DashboardHeight}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 第一排：泵控制 + 高压电源 + 电池 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30.3*" />
                    <!-- 1. 泵控制 (Devices[1]) -->
                    <ColumnDefinition Width="58*" />
                    <!-- 2. 高压电源 (Devices[0]) -->
                    <ColumnDefinition Width="11.7*" />
                    <!-- 3. 电池 -->
                </Grid.ColumnDefinitions>

                <!-- 1. 泵控制卡片 -->
                <components:DeviceControlCard Grid.Column="0" DataContext="{Binding Devices[1]}" Margin="5,5,2.5,2.5"/>

                <!-- 2. 高压电源卡片 -->
                <components:DeviceControlCard Grid.Column="1" DataContext="{Binding Devices[0]}" Margin="2.5,5,2.5,2.5"/>

                <!-- 3. 电池状态卡片 -->
                <materialDesign:Card Grid.Column="2" Margin="2.5,5,5,2.5" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
                    <components:BatteryIcon DataContext="{Binding BatteryVM}" 
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                </materialDesign:Card>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30*" />
                    <ColumnDefinition Width="17.5*" />
                    <ColumnDefinition Width="17.5*" />
                    <ColumnDefinition Width="17.5*" />
                    <ColumnDefinition Width="17.5*" />
                </Grid.ColumnDefinitions>

                <components:DeviceControlCard Grid.Column="0" 
                                              DataContext="{Binding Devices[2]}" 
                                              Margin="5,2.5,0,5"/>

                <materialDesign:Card Grid.Column="1" Margin="5,2.5,0,5" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- 左上角小标题 -->
                        <TextBlock Grid.Row="0" Margin="8" Text="转向阀门" FontSize="12" Foreground="{DynamicResource PurpleThemeBrush}" Opacity="0.5" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtCH1" Text="1" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="14" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource PurpleThemeBrush}"/>
                                        <Setter Property="Opacity" Value="0.5"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSteeringValveActive}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                <Setter Property="Opacity" Value="1.0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ToggleButton Style="{StaticResource PurpleSwitchStyle}"
                                          IsChecked="{Binding IsSteeringValveActive, Mode=TwoWay}"
                                          ToolTip="切换转向阀通道">
                                <materialDesign:PackIcon Kind="ArrowLeft" RenderTransformOrigin=".5,.5" />
                                <materialDesign:ToggleButtonAssist.OnContent>
                                    <materialDesign:PackIcon Kind="ArrowRight" />
                                </materialDesign:ToggleButtonAssist.OnContent>
                            </ToggleButton>

                            <TextBlock x:Name="TxtCH2" Text="2" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="14" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource PurpleThemeBrush}"/>
                                        <Setter Property="Opacity" Value="0.5"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSteeringValveActive}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                <Setter Property="Opacity" Value="1.0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="2" Margin="5,2.5,0,5" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
                    <Button Command="{Binding OpenPlatform3DWindowCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Height="Auto" Padding="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="三维平台" FontSize="20" FontWeight="Bold" Foreground="Black"/>
                        </StackPanel>
                    </Button>
                </materialDesign:Card>

                <!-- 5. 测样模式切换卡片 -->
                <materialDesign:Card Grid.Column="3" Margin="5,2.5,0,5" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- 左上角小标题 -->
                        <TextBlock Grid.Row="0" Text="测样模式" FontSize="12" Foreground="{DynamicResource PurpleThemeBrush}" Opacity="0.5" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                        <!-- 居中的拨动开关组 -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- 连续测量文字 -->
                            <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" FontSize="14" FontWeight="Bold" TextAlignment="Center">
                                <Run Text="连"/><LineBreak/><Run Text="续"/>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource PurpleThemeBrush}"/>
                                        <Setter Property="Opacity" Value="0.5"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFlowInjectionMode}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                <Setter Property="Opacity" Value="1.0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- 切换开关 -->
                            <ToggleButton Style="{StaticResource PurpleSwitchStyle}" 
                                          IsChecked="{Binding IsFlowInjectionMode, Mode=TwoWay}" 
                                          Click="ToggleButton_Click"
                                          ToolTip="切换：连续进样 / 流动注射">
                                <materialDesign:PackIcon Kind="ArrowLeft" RenderTransformOrigin=".5,.5" />
                                <materialDesign:ToggleButtonAssist.OnContent>
                                    <materialDesign:PackIcon Kind="ArrowRight" />
                                </materialDesign:ToggleButtonAssist.OnContent>
                            </ToggleButton>

                            <!-- 流动注射文字 -->
                            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" FontSize="14" FontWeight="Bold" TextAlignment="Center">
                                <Run Text="流"/><LineBreak/><Run Text="动"/>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource PurpleThemeBrush}"/>
                                        <Setter Property="Opacity" Value="0.5"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFlowInjectionMode}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                <Setter Property="Opacity" Value="1.0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- 6. 点火按钮卡片 -->
                <materialDesign:Card Grid.Column="4" Margin="5,2.5,5,5" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
                    <Button Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="Auto" Padding="0" Command="{Binding FireCommand}">
                        <TextBlock Text=" 点 火 " FontSize="24" FontWeight="Bold" Foreground="IndianRed" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </materialDesign:Card>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding ParamHeaderHeight}" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource MaterialDesignPaper}" Margin="5,2,2.5,2" CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="15,0,20,0">
                            <TextBlock Text="积分时间:" VerticalAlignment="Center" Opacity="0.6" Margin="0,0,5,0"/>
                            <Button Style="{StaticResource MaterialDesignFlatButton}" 
                                    Content="{Binding SpecVM.IntegrationTimeMs, StringFormat={}{0} ms}"
                                    Command="{Binding OpenIntegrationTimeConfigCommand}"
                                    Width="90" Height="28" Padding="5,0,0,0" HorizontalContentAlignment="Left" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,15,0">
                            <TextBlock Text="平均次数:" VerticalAlignment="Center" Opacity="0.6" Margin="0,0,5,0"/>
                            <Button Style="{StaticResource MaterialDesignFlatButton}" 
                                    Content="{Binding SpecVM.AveragingCount}"
                                    Command="{Binding OpenAveragingCountConfigCommand}"
                                    Width="90" Height="28" Padding="5,0,0,0" HorizontalContentAlignment="Left" />
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="{Binding StatusInfo}" 
                                   VerticalAlignment="Center" HorizontalAlignment="Center" 
                                   FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                            <TextBlock Text="触屏框选" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold" Opacity="0.7"/>
                            <ToggleButton x:Name="BtnTouchBoxZoom" 
                                          Style="{StaticResource MaterialDesignSwitchToggleButton}" 
                                          ToolTip="开启后，单指在图表上滑动即可框选放大">
                                <ToggleButton.LayoutTransform>
                                    <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
                                </ToggleButton.LayoutTransform>
                            </ToggleButton>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="Black" Margin="5,0,2.5,5" CornerRadius="8">
                    <Grid>
                        <ScottPlot:WpfPlot x:Name="SpecPlot" />

                        <Canvas x:Name="ZoomCanvas" IsHitTestVisible="False" ClipToBounds="True">
                            <Rectangle x:Name="ZoomRectangle" Stroke="#FF4081" StrokeThickness="2" Fill="#33FF4081" Visibility="Collapsed" />
                        </Canvas>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="1" Margin="2.5,0,5,5">
                <UniformGrid Columns="1" Rows="6">
                    <Button Style="{StaticResource SideOperationButtonStyle}" Content="{Binding SpecVM.MeasurementButtonText}"
                            Command="{Binding ToggleSpectrometerCommand}" />
                    <Button Style="{StaticResource SideOperationButtonStyle}" 
                            Content="{Binding ReferenceFileButtonText}" 
                            Command="{Binding ToggleReferenceFileCommand}" />
                    <Button Style="{StaticResource SideOperationButtonStyle}" Content="单幅保存" 
                            Command="{Binding SingleSaveCommand}" />
                    <Button Style="{StaticResource SideOperationButtonStyle}" 
                            Content="脚本保存" 
                            Command="{Binding OpenScriptSaveWindowCommand}"/>

                    <Button Style="{StaticResource SideOperationButtonStyle}" Content="自动范围" 
                            Command="{Binding AutoRangeCommand}" />
                    <Button Style="{StaticResource SideOperationButtonStyle}" Content="最大范围" 
                            Command="{Binding MaxRangeCommand}" />
                </UniformGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>