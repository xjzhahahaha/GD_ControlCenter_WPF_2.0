<UserControl x:Class="GD_ControlCenter_WPF.Views.Pages.ElementConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:GD_ControlCenter_WPF.Helpers"
             Background="{DynamicResource MaterialDesignPaper}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <helpers:InverseBoolToVisConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 核心二大列布局 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- ================= 1. 左侧区域 ================= -->
            <Grid Grid.Column="0" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="7.5*"/>
                    <!-- 上面：元素周期表 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 分割线 -->
                    <RowDefinition Height="2.5*"/>
                    <!-- 下面：波长库与暂存区 -->
                </Grid.RowDefinitions>

                <!-- 上：元素周期表 -->
                <materialDesign:Card Grid.Row="0" Margin="0,0,0,5" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2" Background="#FAFAFA">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text=" 选 择 分 析 元 素 " Style="{StaticResource MaterialDesignSubtitle2TextBlock}" Opacity="0.8" Margin="0,0,0,8"/>

                        <!-- 自适应缩放的周期表网格 -->
                        <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding PeriodicElements}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid>
                                            <!-- 18 族 -->
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="38"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- 10 行 (包含中间留白的第7行) -->
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="38"/>
                                                <RowDefinition Height="38"/>
                                                <RowDefinition Height="38"/>
                                                <RowDefinition Height="38"/>
                                                <RowDefinition Height="38"/>
                                                <RowDefinition Height="38"/>
                                                <RowDefinition Height="38"/>
                                                <RowDefinition Height="15"/>
                                                <RowDefinition Height="38"/>
                                                <RowDefinition Height="38"/>
                                            </Grid.RowDefinitions>
                                        </Grid>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Grid.Row" Value="{Binding Row}" />
                                        <Setter Property="Grid.Column" Value="{Binding Column}" />
                                        <Setter Property="Margin" Value="1.5"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="ElementBorder" Background="{Binding HexColor}" CornerRadius="2" Cursor="Hand"
                                                BorderThickness="2" BorderBrush="Transparent"
                                                ToolTip="{Binding AtomicNumber, StringFormat='原子序数: {0}'}">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" 
                                                              Command="{Binding DataContext.SelectElementCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                              CommandParameter="{Binding Symbol}"/>
                                            </Border.InputBindings>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="NumText" Text="{Binding AtomicNumber}" FontSize="8" Foreground="#555" HorizontalAlignment="Left" Margin="2,1,0,0"/>
                                                <TextBlock x:Name="SymText" Text="{Binding Symbol}" FontSize="15" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="0,-3,0,2"/>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="ElementBorder" Property="BorderBrush" Value="#E65100" />
                                                <Setter TargetName="ElementBorder" Property="Background" Value="#FFE0B2" />
                                                <Setter TargetName="SymText" Property="Foreground" Value="#D84315" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Viewbox>
                    </Grid>
                </materialDesign:Card>

                <!-- 优雅的可拖动水平分割线 -->
                <GridSplitter Grid.Row="1" Height="10" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" Cursor="SizeNS" ShowsPreview="True"/>

                <!-- 下：特征波长 与 测样参数 (两行一列) -->
                <Grid Grid.Row="2" Margin="0,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <!-- 第一行：特征波长 -->
                    <materialDesign:Card Grid.Row="0" Margin="0,0,0,2.5" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="{Binding SelectedElementSymbol, StringFormat='[{0}] 特 征 波 长 '}" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" Opacity="0.8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            
                            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal">
                                    <ItemsControl ItemsSource="{Binding CurrentWavelengths}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- 非编辑模式：按钮，点击加入 -->
                                                    <Button Command="{Binding DataContext.AddWavelengthToActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Value}" 
                                                            Style="{StaticResource MaterialDesignFlatButton}" Margin="2,0" ToolTip="点击加入分析配置"
                                                            Visibility="{Binding DataContext.IsWavelengthEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVis}}">
                                                        <TextBlock Text="{Binding Value, StringFormat={}{0} nm}" FontSize="15" />
                                                    </Button>
                                                    
                                                    <!-- 编辑模式：文本框 -->
                                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}" Width="60" Margin="5,0"
                                                             Visibility="{Binding DataContext.IsWavelengthEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    
                                    <!-- 编辑模式的加号按钮 -->
                                    <Button Command="{Binding AddNewWavelengthCommand}" Style="{StaticResource MaterialDesignIconButton}" ToolTip="添加新波长" Width="30" Height="30" Margin="5,0"
                                            Visibility="{Binding IsWavelengthEditing, Converter={StaticResource BoolToVis}}">
                                        <materialDesign:PackIcon Kind="Plus" />
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 动态切换文字的编辑按钮 -->
                            <Button Grid.Column="2" 
                                    Command="{Binding ToggleWavelengthEditCommand}" 
                                    Margin="10,0,0,0" VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                        <Setter Property="Content" Value="编辑" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWavelengthEditing}" Value="True">
                                                <Setter Property="Content" Value="确认改动" />
                                                <Setter Property="Foreground" Value="IndianRed" />
                                                <Setter Property="BorderBrush" Value="IndianRed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </materialDesign:Card>

                    <!-- 第二行：测样参数 -->
                    <materialDesign:Card Grid.Row="1" Margin="0,2.5,0,0" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="测 样 参 数 " Style="{StaticResource MaterialDesignSubtitle2TextBlock}" Opacity="0.8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 积分时间 -->
                                <TextBlock Text="积分时间:" VerticalAlignment="Center" Margin="10,0,5,0" FontSize="15" />
                                <TextBlock Text="{Binding CurrentIntegrationTime, StringFormat={}{0} ms}" VerticalAlignment="Center" FontSize="15" 
                                           Visibility="{Binding IsParameterEditing, Converter={StaticResource InverseBoolToVis}}" />
                                <TextBox Text="{Binding CurrentIntegrationTime, UpdateSourceTrigger=LostFocus}" Width="50" FontSize="15" 
                                         Visibility="{Binding IsParameterEditing, Converter={StaticResource BoolToVis}}" />
                                         
                                <!-- 平均次数 -->
                                <TextBlock Text="平均次数:" VerticalAlignment="Center" Margin="20,0,5,0" FontSize="15" />
                                <TextBlock Text="{Binding CurrentAveragingCount}" VerticalAlignment="Center" FontSize="15" 
                                           Visibility="{Binding IsParameterEditing, Converter={StaticResource InverseBoolToVis}}" />
                                <TextBox Text="{Binding CurrentAveragingCount, UpdateSourceTrigger=LostFocus}" Width="40" FontSize="15" 
                                         Visibility="{Binding IsParameterEditing, Converter={StaticResource BoolToVis}}" />
                                         
                                <!-- 拟合曲线 -->
                                <TextBlock Text="拟合曲线:" VerticalAlignment="Center" Margin="20,0,5,0" FontSize="15" />
                                <ComboBox x:Name="FittingCurveComboBox" ItemsSource="{Binding CurrentFittingCurves}" SelectedItem="{Binding SelectedFittingCurve}" Width="120" VerticalAlignment="Center" FontSize="15" DropDownOpened="FittingCurveComboBox_DropDownOpened">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="15">
                                                <TextBlock.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="删除" Command="{Binding DataContext.DeleteFittingCurveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Foreground="IndianRed">
                                                            <MenuItem.Icon>
                                                                <materialDesign:PackIcon Kind="Delete" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </TextBlock.ContextMenu>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- 动态切换文字的编辑按钮 -->
                            <Button Grid.Column="2" 
                                    Command="{Binding ToggleParameterEditCommand}" 
                                    Margin="10,0,0,0" VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                        <Setter Property="Content" Value="编辑" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsParameterEditing}" Value="True">
                                                <Setter Property="Content" Value="确认改动" />
                                                <Setter Property="Foreground" Value="IndianRed" />
                                                <Setter Property="BorderBrush" Value="IndianRed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </Grid>

            <!-- 优雅的可拖动垂直分割线 -->
            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" ShowsPreview="True"/>

            <!-- ================= 3. 右侧区域 (已选分析配置) ================= -->
            <Grid Grid.Column="2" Margin="5">
                <materialDesign:Card UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text=" 最 终 已 选 分 析 配 置 " Style="{StaticResource MaterialDesignSubtitle2TextBlock}" Opacity="0.8"/>
                            <Separator Margin="0,4,0,4" Style="{StaticResource MaterialDesignLightSeparator}"/>
                        </StackPanel>
                        
                        <ListBox Grid.Row="1" ItemsSource="{Binding SelectedConfigs}" SelectedItem="{Binding CurrentSelectedConfig, Mode=TwoWay}"
                                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Margin="0,5,0,5">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="0,5,0,8">
                                        <!-- 元素 波长 / 积分时间 平均次数 / 曲线 -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            
                                            <!-- 第一行：元素-波长 -->
                                            <TextBlock Grid.Row="0" FontSize="15" Margin="0,0,0,4">
                                                <Run Text="{Binding ElementName, Mode=OneWay}" FontWeight="Bold" />
                                                <Run Text=" - " FontWeight="Bold" />
                                                <Run Text="{Binding Wavelength, StringFormat={}{0} nm, Mode=OneWay}" />
                                            </TextBlock>
                                            
                                            <!-- 第二行：积分时间-平均次数 -->
                                            <TextBlock Grid.Row="1" FontSize="15" Margin="0,0,0,4">
                                                <Run Text="{Binding IntegrationTime, StringFormat={}{0} ms, Mode=OneWay}" />
                                                <Run Text=" - " />
                                                <Run Text="{Binding AveragingCount, StringFormat={}{0} 次, Mode=OneWay}" />
                                            </TextBlock>
                                            
                                            <!-- 第三行：拟合曲线 -->
                                            <TextBlock Grid.Row="2" FontSize="15">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding FittingCurve}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FittingCurve}" Value="">
                                                                <Setter Property="Text" Value="无拟合曲线"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FittingCurve}" Value="{x:Null}">
                                                                <Setter Property="Text" Value="无拟合曲线"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        
                        <!-- 底部删除按钮移动到此处 -->
                        <Button Grid.Row="2" Content="删除选中配置" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                Command="{Binding RemoveSelectedConfigCommand}" 
                                Foreground="IndianRed" BorderBrush="IndianRed" Height="36" Margin="0,5,0,0"/>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>