<UserControl x:Class="GD_ControlCenter_WPF.Views.Pages.ReportGenerationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource MaterialDesignPaper}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*" />
            <!-- 左列：报告配置 -->
            <ColumnDefinition Width="6*" />
            <!-- 右列：预览与操作 -->
        </Grid.ColumnDefinitions>

        <!-- ================= 左侧列：报告配置 ================= -->
        <Grid Grid.Column="0" Margin="0,0,6,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. 模板选择 -->
            <materialDesign:Card Grid.Row="0" Margin="0,0,0,8" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel Margin="16,12">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <materialDesign:PackIcon Kind="FileDocumentEditOutline" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBlock Text="报告模板选择" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="8,0,0,0" FontWeight="Bold"/>
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding ReportTemplates}" SelectedItem="{Binding SelectedTemplate}"
                              materialDesign:HintAssist.Hint="选择官方标准模板" Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                </StackPanel>
            </materialDesign:Card>

            <!-- 2. 实验基本信息 -->
            <materialDesign:Card Grid.Row="1" Margin="0,4,0,8" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel Margin="16,12">
                    <TextBlock Text="实验信息登记" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" Opacity="0.6" Margin="0,0,0,12"/>
                    <TextBox Text="{Binding ReportTitle, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="报告名称 / Report Title" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,12"/>
                    <TextBox Text="{Binding OperatorName, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="检测人 / Operator" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,12"/>
                    <TextBox Text="{Binding ReportNote}" materialDesign:HintAssist.Hint="实验备注" AcceptsReturn="True" TextWrapping="Wrap" Height="80" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" VerticalContentAlignment="Top"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- 3. 内容过滤器 -->
            <materialDesign:Card Grid.Row="2" Margin="0,4,0,0" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid Margin="16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="报告包含内容" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" Opacity="0.6" Margin="0,0,0,12"/>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel>
                            <CheckBox Content="包含各元素校准拟合曲线" IsChecked="{Binding IncludeCalibrationCurves}" Margin="0,4"/>
                            <CheckBox Content="包含样品最终浓度计算结果" IsChecked="{Binding IncludeSampleResults}" Margin="0,4"/>
                            <!-- <CheckBox Content="包含标准点原始响应数据" IsChecked="{Binding IncludeStandardData}" Margin="0,4"/> -->
                            <!-- <CheckBox Content="包含 RSD 稳定性分析统计" IsChecked="{Binding IncludeRsdAnalysis}" Margin="0,4"/> -->
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- ================= 右侧列：流式排版预览 ================= -->
        <Grid Grid.Column="1" Margin="6,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. FlowDocument 预览区 -->
            <materialDesign:Card Grid.Row="0" Margin="0,0,0,8" UniformCornerRadius="8" Background="#F5F5F5" materialDesign:ElevationAssist.Elevation="Dp2">
                <!-- FlowDocumentScrollViewer 提供原生的分页打印和缩放支持 -->
                <FlowDocumentScrollViewer Zoom="80">
                    <FlowDocument x:Name="ReportDocument" PagePadding="40" FontFamily="Microsoft YaHei" Background="White">
                        <!-- 报告抬头 -->
                        <Paragraph TextAlignment="Center" FontSize="26" FontWeight="Bold" Margin="0,0,0,20">
                            <Run Text="{Binding ReportTitle}"/>
                        </Paragraph>

                        <Paragraph TextAlignment="Right" FontSize="12" Foreground="Gray" Margin="0,0,0,20">
                            <Run Text="生成日期: "/>
                            <Run Text="{Binding ReportDate}"/>
                        </Paragraph>

                        <!-- 基本信息 -->
                        <Paragraph FontSize="16" FontWeight="Bold" Background="#EEE" Padding="5">
                            一、 基本信息
                        </Paragraph>
                        <Paragraph>
                            <Run Text="检测人：" FontWeight="Bold"/> <Run Text="{Binding OperatorName}"/>
                        </Paragraph>
                        <Paragraph>
                            <Run Text="备注描述：" FontWeight="Bold"/> <Run Text="{Binding ReportNote}"/>
                        </Paragraph>

                        <!-- 校准曲线图表汇总 (ItemsControl 呈现多张图) -->
                        <BlockUIContainer>
                            <StackPanel Visibility="{Binding IncludeCalibrationCurves, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="二、 校准曲线图表与方程" FontSize="16" FontWeight="Bold" Background="#EEE" Padding="5" Margin="0,20,0,10"/>
                                <ItemsControl ItemsSource="{Binding CalibrationData}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                                <Image Source="{Binding GraphImage}" Width="300" Height="200" Margin="0,0,20,0"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ElementName, StringFormat='元素通道：{0}'}" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                                                    <TextBlock Text="{Binding Equation, StringFormat='拟合方程：{0}'}" Margin="0,0,0,5"/>
                                                    <TextBlock Text="{Binding R2, StringFormat='R² 值：{0}'}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </BlockUIContainer>

                        <!-- 样品测定结果汇总 -->
                        <BlockUIContainer>
                            <StackPanel Visibility="{Binding IncludeSampleResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="三、 待测样品浓度计算结果" FontSize="16" FontWeight="Bold" Background="#EEE" Padding="5" Margin="0,20,0,10"/>
                                <DataGrid ItemsSource="{Binding SampleData}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="White" BorderBrush="#CCC" BorderThickness="1">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="样品名称" Binding="{Binding SampleName}" Width="150"/>
                                        <DataGridTextColumn Header="测定元素" Binding="{Binding ElementName}" Width="100"/>
                                        <DataGridTextColumn Header="绝对发光强度" Binding="{Binding Intensity, StringFormat={}{0:F2}}" Width="120"/>
                                        <DataGridTextColumn Header="RSD (%)" Binding="{Binding RSD, StringFormat={}{0:F2}}" Width="100"/>
                                        <DataGridTextColumn Header="计算浓度" Binding="{Binding CalculatedConc}" Width="120" FontWeight="Bold"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </BlockUIContainer>

                        <!-- 流动注射时序总图 -->
                        <BlockUIContainer>
                            <StackPanel Visibility="{Binding HasFlowInjectionGraphs, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="四、流动注射全程时序曲线追踪" FontSize="16" FontWeight="Bold" Background="#EEE" Padding="5" Margin="0,20,0,10"/>
                                <ItemsControl ItemsSource="{Binding FlowInjectionGraphs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,30">
                                                <TextBlock Text="{Binding SampleName, StringFormat='样品名称：{0}'}" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                                                <Image Source="{Binding GraphImage}" Width="700" Height="350" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </BlockUIContainer>

                        <Paragraph Margin="0,50,0,0" TextAlignment="Center" FontSize="12" Foreground="Gray">
                            —— 报告结束 ——
                        </Paragraph>
                    </FlowDocument>
                </FlowDocumentScrollViewer>
            </materialDesign:Card>

            <!-- 2. 底部导出控制区 -->
            <materialDesign:Card Grid.Row="1" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp3" 
                                 Background="{DynamicResource PrimaryHueLightBrush}" Foreground="{DynamicResource PrimaryHueLightForegroundBrush}">
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="InformationOutline" VerticalAlignment="Center" Opacity="0.7"/>
                        <TextBlock Text="提示：原生 PDF 导出将调用 Windows 虚拟打印机。" Margin="8,0,0,0" Opacity="0.7"/>
                    </StackPanel>

                    <!-- 按钮组 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="刷新预览" Command="{Binding PreviewReportCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Background="White" Margin="0,0,8,0"/>
                        <Button Content="打印 / 导出 PDF" Command="{Binding ExportPdfCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#E53935" BorderBrush="#E53935" Margin="0,0,8,0">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Printer" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="打印 / 导出 PDF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>