<UserControl x:Class="GD_ControlCenter_WPF.Views.Pages.ReportGenerationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource MaterialDesignPaper}">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*" />
            <!-- 左列：报告配置 -->
            <ColumnDefinition Width="6*" />
            <!-- 右列：预览与操作 -->
        </Grid.ColumnDefinitions>

        <!-- ================= 左侧列：报告配置 ================= -->
        <Grid Grid.Column="0" Margin="0,0,6,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 模板选择 -->
                <RowDefinition Height="Auto"/>
                <!-- 基本信息 -->
                <RowDefinition Height="*"/>
                <!-- 内容勾选 -->
            </Grid.RowDefinitions>

            <!-- 1. 模板选择 -->
            <materialDesign:Card Grid.Row="0" Margin="0,0,0,8" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel Margin="16,12">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <materialDesign:PackIcon Kind="FileDocumentEditOutline" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBlock Text="报告模板选择" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="8,0,0,0" FontWeight="Bold"/>
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding ReportTemplates}" SelectedItem="{Binding SelectedTemplate}"
                              materialDesign:HintAssist.Hint="选择官方标准模板" Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                </StackPanel>
            </materialDesign:Card>

            <!-- 2. 实验基本信息 -->
            <materialDesign:Card Grid.Row="1" Margin="0,4,0,8" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel Margin="16,12">
                    <TextBlock Text="实验信息登记" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" Opacity="0.6" Margin="0,0,0,12"/>
                    <TextBox Text="{Binding OperatorName}" materialDesign:HintAssist.Hint="检测人 / Operator" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,12"/>
                    <TextBox Text="{Binding AuditorName}" materialDesign:HintAssist.Hint="审核人 / Auditor" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,12"/>
                    <TextBox Text="{Binding LabId}" materialDesign:HintAssist.Hint="实验室编号 / Lab ID" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,12"/>
                    <TextBox Text="{Binding ReportNote}" materialDesign:HintAssist.Hint="实验备注" AcceptsReturn="True" TextWrapping="Wrap" Height="80" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" VerticalContentAlignment="Top"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- 3. 内容过滤器 -->
            <materialDesign:Card Grid.Row="2" Margin="0,4,0,0" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid Margin="16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="报告包含内容" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" Opacity="0.6" Margin="0,0,0,12"/>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel>
                            <CheckBox Content="包含实时全谱图 (Snapshot)" IsChecked="{Binding IncludeFullSpectrum}" Margin="0,4"/>
                            <CheckBox Content="包含各元素校准拟合曲线" IsChecked="{Binding IncludeCalibrationCurves}" Margin="0,4"/>
                            <CheckBox Content="包含标准点原始响应数据" IsChecked="{Binding IncludeStandardData}" Margin="0,4"/>
                            <CheckBox Content="包含样品最终浓度计算结果" IsChecked="{Binding IncludeSampleResults}" Margin="0,4"/>
                            <CheckBox Content="包含 RSD 稳定性分析统计" IsChecked="{Binding IncludeRsdAnalysis}" Margin="0,4"/>
                            <CheckBox Content="包含硬件状态快照 (HV/Pump)" IsChecked="{Binding IncludeHardwareStatus}" Margin="0,4"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- ================= 右侧列：模拟预览 ================= -->
        <Grid Grid.Column="1" Margin="6,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <!-- 模拟纸张预览 -->
                <RowDefinition Height="Auto"/>
                <!-- 操作按钮 -->
            </Grid.RowDefinitions>

            <!-- 1. 模拟纸张预览区域 -->
            <materialDesign:Card Grid.Row="0" Margin="0,0,0,8" UniformCornerRadius="8" Background="#F5F5F5" materialDesign:ElevationAssist.Elevation="Dp2">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <!-- 模拟白色 A4 纸 -->
                    <Border Background="White" Width="500" Margin="20" BorderBrush="#E0E0E0" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                        </Border.Effect>

                        <StackPanel Margin="40">
                            <TextBlock Text="实验检测报告" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                            <Separator Background="Black" Margin="0,0,0,20"/>

                            <!-- 模拟预览内容 -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding OperatorName, StringFormat='检测人：{0}'}" Margin="0,4"/>
                                    <TextBlock Text="{Binding LabId, StringFormat='实验 ID：{0}'}" Margin="0,4"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="日期：2023-10-27" Margin="0,4"/>
                                    <TextBlock Text="状态：已审核" Foreground="Green" Margin="0,4"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="#F9F9F9" Height="150" CornerRadius="4" BorderBrush="#EEEEEE" BorderThickness="1">
                                <TextBlock Text="[ 校准曲线图占位预览 ]" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.3"/>
                            </Border>

                            <TextBlock Text="[ 样品测定数据汇总表 ]" Margin="0,20,0,0" HorizontalAlignment="Center" Opacity="0.3"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </materialDesign:Card>

            <!-- 2. 底部导出控制区 -->
            <materialDesign:Card Grid.Row="1" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp3" 
                                 Background="{DynamicResource PrimaryHueLightBrush}" Foreground="{DynamicResource PrimaryHueLightForegroundBrush}">
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="InformationOutline" VerticalAlignment="Center" Opacity="0.7"/>
                        <TextBlock Text="提示：报告生成后将自动以 PDF 格式预览。" Margin="8,0,0,0" Opacity="0.7"/>
                    </StackPanel>

                    <!-- 按钮组 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="预览报告" Command="{Binding PreviewReportCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Background="White" Margin="0,0,8,0"/>
                        <Button Content="导出 PDF" Command="{Binding ExportPdfCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#E53935" BorderBrush="#E53935" Margin="0,0,8,0">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FilePdfBox" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="导出 PDF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>