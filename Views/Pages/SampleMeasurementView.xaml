<UserControl x:Class="GD_ControlCenter_WPF.Views.Pages.SampleMeasurementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:helpers="clr-namespace:GD_ControlCenter_WPF.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1366">
    <UserControl.Resources>
        <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
        <helpers:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.5*" />
            <!-- 1. 序列 -->
            <ColumnDefinition Width="5*" />
            <!-- 2. 图表 -->
            <ColumnDefinition Width="2.5*" />
            <!-- 3. 控制 -->
        </Grid.ColumnDefinitions>

        <!-- ================= 1. 左侧：序列 ================= -->
        <materialDesign:Card Grid.Column="0" Margin="5" UniformCornerRadius="8"
                             materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="待测任务序列" FontWeight="Bold" FontSize="16"
                           Margin="0,0,0,10" Opacity="0.6"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding MeasurementSequence}"
                          SelectedItem="{Binding CurrentSample}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="85">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="采集数据中...">
                                            <Setter Property="Foreground" Value="Orange"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="已完成">
                                            <Setter Property="Foreground" Value="Green"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="样品名称" Binding="{Binding SampleName}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>

        <!-- ================= 2. 中间：双图 ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- 上图：全谱 -->
            <materialDesign:Card Grid.Row="0" Margin="2.5,5" UniformCornerRadius="8"
                                 materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <TextBlock Text="实时全谱监控 (Full Spectrum)" VerticalAlignment="Top"
                               HorizontalAlignment="Left" Margin="15,10" Opacity="0.5" Style="{StaticResource MaterialDesignSubtitle2TextBlock}"/>
                    <ScottPlot:WpfPlot x:Name="SpecPlot" Margin="5,35,5,5"/>
                </Grid>
            </materialDesign:Card>

            <!-- 下图：局部 -->
            <materialDesign:Card Grid.Row="1" Margin="2.5,5" UniformCornerRadius="8"
                                 materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                                HorizontalAlignment="Left" Margin="15,10" Panel.ZIndex="1">
                        <TextBlock Text="当前查看元素：" VerticalAlignment="Center" Opacity="0.6"/>
                        <ComboBox ItemsSource="{Binding PickedElements}"
                                  SelectedItem="{Binding SelectedElement}" Width="130" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="元素局部特征峰" VerticalAlignment="Top"
                               HorizontalAlignment="Right" Margin="15,10" Opacity="0.5" Style="{StaticResource MaterialDesignSubtitle2TextBlock}"/>
                    <ScottPlot:WpfPlot x:Name="TrendPlot" Margin="5,45,5,5"/>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- ================= 3. 右侧：结果与控制 ================= -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 样品信息 -->
            <materialDesign:Card Margin="5" UniformCornerRadius="8"
                                 Background="{DynamicResource PrimaryHueMidBrush}" Foreground="White">
                <StackPanel Margin="15">
                    <TextBlock Text="{Binding CurrentSample.SampleName, FallbackValue='未选择'}" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="{Binding CurrentSample.Type}" FontSize="14" Opacity="0.8"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- 原版简洁风格：内嵌单通道多重测量明细卡片 (完全取消二级窗口，不加任何累赘背景，运行零阻碍) -->
            <materialDesign:Card Grid.Row="1" Margin="5" UniformCornerRadius="8">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 1. 顶栏：测定目标特征元素切换下拉框 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="测量强度" VerticalAlignment="Center" FontWeight="Bold" Opacity="0.6" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding CurrentSample.ElementConcentrations}"
                                  SelectedItem="{Binding SelectedPreviewElement}"
                                  DisplayMemberPath="ElementName"
                                  Width="130" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- 2. 中置列表：标准 WPF ListBox，保障系统稳定与最大化流畅度 -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding SelectedPreviewElement.Reps}"
                             Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 测量次序 -->
                                    <TextBlock Text="{Binding RepIndex}" VerticalAlignment="Center" FontSize="14" Foreground="#333333"/>

                                    <!-- 实测结果状态响应 -->
                                    <Grid Grid.Column="1">
                                        <!-- 未采集状态 -->
                                        <TextBlock Text="--" FontSize="14" Foreground="#999999" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Intensity}" Value="{x:Null}"/>
                                                                <Condition Binding="{Binding IsMeasuring}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- 采集中状态提示 -->
                                        <TextBlock Text="采集中..." FontSize="14" Foreground="#673ab7" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMeasuring}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- 数据读取完毕展示数值 -->
                                        <TextBlock Text="{Binding Intensity, StringFormat={}{0:F2}}" FontSize="14" Foreground="#333333" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Intensity}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsMeasuring}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 3. 底栏统计数据展现 -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="平均强度: " FontSize="14" Foreground="#555555"/>
                            <TextBlock Text="{Binding SelectedPreviewElement.MeasuredIntensity, StringFormat={}{0:F2}, FallbackValue='0.00'}" FontSize="14" FontWeight="Bold" Foreground="#333333"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="RSD: " FontSize="14" Foreground="#555555"/>
                            <TextBlock Text="{Binding SelectedPreviewElement.MeasuredRsd, StringFormat={}{0:F2}%, FallbackValue='0.00%'}" FontSize="14" FontWeight="Bold" Foreground="#673ab7"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </materialDesign:Card>

            <!-- 操作按钮区 -->
            <materialDesign:Card Grid.Row="2" Margin="5" UniformCornerRadius="8"
                                 materialDesign:ElevationAssist.Elevation="Dp3">
                <StackPanel Margin="10">

                    <!-- 采样时间参数设置面板 (在非采集状态下允许调节) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,10"
                                Visibility="{Binding IsCollecting, Converter={StaticResource InverseBoolConverter}}">
                        <TextBlock Text="单次积分采集时间: " VerticalAlignment="Center" FontSize="12" Foreground="#555555"/>
                        <TextBox Width="45" TextAlignment="Center" VerticalAlignment="Center" FontSize="12.5" Margin="5,0,0,0"
                                 FontWeight="Bold" Foreground="#673ab7"
                                 Text="{Binding SingleMeasurementDuration, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text=" 秒" VerticalAlignment="Center" FontSize="12" Foreground="#555555"/>
                    </StackPanel>

                    <!-- 采集过程中的轮次与实时进度展示 -->
                    <Grid Margin="0,0,0,10" Visibility="{Binding IsCollecting, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                            <TextBlock Text="自动测量进度: " FontWeight="Bold" Foreground="#673ab7" FontSize="13"/>
                            <TextBlock Text="{Binding CurrentMeasurementIndex}" FontWeight="Bold" Foreground="#673ab7" FontSize="13"/>
                            <TextBlock Text=" / " FontSize="13"/>
                            <TextBlock Text="{Binding TotalMeasurementCount}" FontSize="13"/>
                            <TextBlock Text=" 次" FontSize="13"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{Binding CollectionProgressText}" HorizontalAlignment="Center" 
                                   FontStyle="Italic" Foreground="Gray" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Grid>

                    <!-- 1. 核心采集按钮 (动态切换颜色和文字) -->
                    <Button Height="70" FontSize="20" FontWeight="Bold">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                <Setter Property="Content" Value="开始采集数据"/>
                                <Setter Property="Command" Value="{Binding StartCollectingCommand}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCollecting}" Value="True">
                                        <Setter Property="Content" Value="停止采集并保存"/>
                                        <Setter Property="Background" Value="IndianRed"/>
                                        <Setter Property="BorderBrush" Value="IndianRed"/>
                                        <Setter Property="Command" Value="{Binding StopAndSaveCommand}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 2. 【新增】：导出数据按钮 -->
                    <Button Content="导出实验快照"
                            Command="{Binding ExportCurrentSessionCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,10,0,0"
                            Height="45"
                            ToolTip="将本次实验的所有测量结果保存为 JSON 文件"/>
                    <TextBlock Text="* 导出数据可用于后续脱机处理"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0" Opacity="0.4" FontSize="10"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>